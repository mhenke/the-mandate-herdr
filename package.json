{
  "name": "the-mandate-herdr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Keyboard-first browser political thriller teaching authentic Herdr TUI workflows. L1-L3 vertical slice (M2).",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.css\" && prettier --check .",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" --fix && prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:changed": "knip && fallow audit --base origin/main",
    "graphify:update": "graphify update .",
    "graphify:report": "graphify cluster-only .",
    "ci:watch": "bash scripts/watch-ci.sh",
    "mutation": "stryker run"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fallow": "3.47.0",
    "fast-check": "4.11.0",
    "knip": "6.48.0",
    "prettier": "3.10.1",
    "stylelint": "18.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
